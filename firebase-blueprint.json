{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the system.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "User specific task.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "type": { "type": "string" },
        "tag": { "type": "string", "description": "Optional category, tag or area" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "completed", "createdAt"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "User's daily tracking for things like water and mood.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "dateLabel": { "type": "string" },
        "water": { "type": "number" },
        "mood": { "type": "string" },
        "focus": { "type": "string", "description": "The main goal or focus for the day" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "dateLabel", "water", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks belonging to the user"
    },
    "/users/{userId}/daily_logs/{dateStr}": {
      "schema": { "$ref": "#/entities/DailyLog" },
      "description": "Daily tracking logs for a user"
    }
  }
}
